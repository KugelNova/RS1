<?xml version="1.0"?>
<sdf version='1.8'>
  <world name="simple_trees">

    <!-- Basic world setup -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.81</gravity>

    <magnetic_field>
      6e-06 2.3e-05 -4.2e-05
    </magnetic_field>

    <atmosphere type="adiabatic"/>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <shadows>1</shadows>
    </scene>


    <!-- Initialise spherical coordinates -->
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>


    <!-- Small ground plane with grass texture -->
    <include>
      <uri>
        model://grass_plane
      </uri>

      <name>grass_plane</name>

      <pose>
        0 0 0 0 0 0
      </pose>
    </include>


    <!-- Oak tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>

      <name>oak1</name>

      <pose>
        0 3.0 0 0 0 0
      </pose>
    </include>


    <!-- Pine tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine%20tree
      </uri>

      <name>pine1</name>

      <pose>
        5.0 0.0 0 0 0 0
      </pose>
    </include>


    <!-- ======================================================== -->
    <!-- THERMAL TEST TARGET                                      -->
    <!-- ======================================================== -->

    <model name="thermal_test_target">

      <!-- Keep target fixed -->
      <static>true</static>

      <!--
        Parrot currently spawns near x=2, y=0.
        This places the test target directly ahead of the drone.
      -->
      <pose>
        4.2 0.0 0.5 0 0 0
      </pose>

      <link name="thermal_target_link">

        <!-- Physical collision -->
        <collision name="thermal_target_collision">
          <geometry>
            <box>
              <size>
                0.6 0.6 1.0
              </size>
            </box>
          </geometry>
        </collision>


        <!-- Visible target -->
        <visual name="thermal_target_visual">

          <geometry>
            <box>
              <size>
                0.6 0.6 1.0
              </size>
            </box>
          </geometry>

          <!-- Make it red so it is easy to identify visually -->
          <material>
            <ambient>
              1.0 0.0 0.0 1.0
            </ambient>

            <diffuse>
              1.0 0.0 0.0 1.0
            </diffuse>

            <specular>
              0.1 0.1 0.1 1.0
            </specular>
          </material>


          <!--
            Simulated body temperature:
            310.15 K = approximately 37 C
          -->
          <plugin
            filename="ignition-gazebo-thermal-system"
            name="ignition::gazebo::systems::Thermal">

            <temperature>
              310.15
            </temperature>

          </plugin>

        </visual>

      </link>

    </model>

    <!-- ======================================================== -->
    <!-- END THERMAL TEST TARGET                                  -->
    <!-- ======================================================== -->


  </world>
</sdf>