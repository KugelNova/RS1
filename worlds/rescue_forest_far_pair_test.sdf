<?xml version="1.0"?>
<sdf version='1.8'>
  <world name="rescue_forest_far_pair_test">
    <!-- Controlled test: humans relocated >=24m from Parrot spawn (2,0,0.8). -->
    <!-- Detector, human model geometry, and thermal proxies are unchanged. -->

    <!-- Essential World Systems -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

     <!-- REQUIRED FOR ALL CAMERAS & THERMAL SENSORS -->
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- World Thermal System with Default Ambient Temp (293.15 K) -->
    <plugin
      filename="ignition-gazebo-thermal-system"
      name="ignition::gazebo::systems::Thermal">
      <temperature>293.15</temperature>
    </plugin>

    <!-- Basic world setup  -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 100 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <!-- <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation> -->
      <direction>-0.5 0.1 -0.9</direction>
      <intensity>5</intensity>
    </light>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.1</max_step_size>
      <real_time_factor>2.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
</physics>
    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>0</shadows>
      <grid>0</grid>
    </scene>

    <!-- Initialise spherical coordinates somewhere -->
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- Large ground planes with forest floor texture -->
    <include>
      <uri>
        model://forest_plane
      </uri>
      <name>forest_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

<!-- Hill 1 -->
<!-- Hill 1 -->
<model name="hill1">
  <static>true</static>

  <pose>25 20 -8 0 0 0</pose>

  <link name="hill_link">

    <collision name="hill_collision">
      <geometry>
        <sphere>
          <radius>12</radius>
        </sphere>
      </geometry>
    </collision>

    <visual name="hill_visual">
      <geometry>
        <sphere>
          <radius>12</radius>
        </sphere>
      </geometry>

      <material>
        <ambient>0.25 0.45 0.15 1</ambient>
        <diffuse>0.25 0.45 0.15 1</diffuse>

	<pbr>
          <metal>
            <albedo_map>
              model://forest_plane/materials/textures/forest_overhead.png
            </albedo_map>
          </metal>
        </pbr>
     
      </material>

    </visual>

  </link>
</model>        
      
<!-- Hill 2 -->
<model name="mountain1">
  <static>true</static>
  <pose>-30 -17 -12 0 0 0</pose>

  <link name="mountain_link">

    <collision name="mountain_collision">
      <geometry>
        <sphere>
          <radius>25</radius>
        </sphere>
      </geometry>
    </collision>

    <visual name="mountain_visual">
      <geometry>
        <sphere>
          <radius>25</radius>
        </sphere>
      </geometry>

      <material>
        <ambient>1.0 1.0 1.0 1</ambient>
        <diffuse>1.0 1.0 1.0 1</diffuse>
        <pbr>
          <metal>
            <albedo_map>
              model://forest_plane/materials/textures/forest_overhead.png
            </albedo_map>
          </metal>
        </pbr>
      </material>

    </visual>

  </link>
</model>

<!-- Ridge 1 -->
<model name="ridge1">
  <static>true</static>
  <pose>20 -25 -2 0 0.25 0.45</pose>

  <link name="ridge_link">

    <collision name="ridge_collision">
      <geometry>
        <box>
          <size>25 8 6</size>
        </box>
      </geometry>
    </collision>

    <visual name="ridge_visual">
      <geometry>
        <box>
          <size>25 8 6</size>
        </box>
      </geometry>

      <material>
        <ambient>1.0 1.0 1.0 1</ambient>
        <diffuse>1.0 1.0 1.0 1</diffuse>
        <pbr>
          <metal>
            <albedo_map>
              model://forest_plane/materials/textures/forest_overhead.png
            </albedo_map>
          </metal>
        </pbr>
      </material>

    </visual>

  </link>
</model>

<!-- Ridge 2 -->
<model name="ridge2">
  <static>true</static>
  <pose>-0 -35 -2.5 0 -0.25 0.45</pose>

  <link name="ridge_link">

    <collision name="ridge_collision">
      <geometry>
        <box>
          <size>25 8 6</size>
        </box>
      </geometry>
    </collision>

    <visual name="ridge_visual">
      <geometry>
        <box>
          <size>25 8 6</size>
        </box>
      </geometry>

      <material>
        <ambient>1.0 1.0 1.0 1</ambient>
        <diffuse>1.0 1.0 1.0 1</diffuse>
        <pbr>
          <metal>
            <albedo_map>
              model://forest_plane/materials/textures/forest_overhead.png
            </albedo_map>
          </metal>
        </pbr>
      </material>

    </visual>

  </link>
</model>

