    <!--  Human 1  -->
<model name="human_1">
  <static>true</static>
  <pose>25 -8 0 0 0 0</pose>
  
  <link name="link">
    <!-- 1. Realistic Visual Mesh for RGB Camera & GUI -->
    <visual name="visual_mesh">
      <pose>0 0 0 0 0 -1.57</pose>
      <geometry>
        <mesh>
          <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing%20person/tip/files/meshes/standing.dae</uri>
        </mesh>
      </geometry>
    </visual>

    <!-- 2. Thermal Proxy Visual (Assigns the 32°C heat signature for the Thermal Camera) -->
    <visual name="thermal_proxy">
      <pose>0 0 0 0 0 -1.57</pose>
      <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing%20person/tip/files/meshes/standing.dae</uri>
            <scale>1.02 1.02 1.02</scale>
          </mesh>
      </geometry>
     
      <transparency>1.0</transparency>
      <cast_shadows>false</cast_shadows>

      <plugin filename="ignition-gazebo-thermal-system" name="ignition::gazebo::systems::Thermal">
        <temperature>305.15</temperature>
      </plugin>
    </visual>

    <collision name="collision">
      <pose>0 0 0.85 0 0 0</pose>
      <geometry>
        <cylinder><radius>0.3</radius><length>1.7</length></cylinder>
      </geometry>
    </collision>
  </link>
</model>

  <!--  Human 2  -->

<model name="human_2">
  <!-- Placed a few meters away from the origin -->
  <pose>36 -2 0 0 0 1.57</pose>
  <static>true</static>
  
  <link name="link">
    <!-- 1. Realistic Visual Mesh -->
    <visual name="visual">
      <geometry>
        <mesh>
          <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing%20person/tip/files/meshes/standing.dae</uri>
        </mesh>
      </geometry>
    </visual>
    
    <!-- 2. Scaled Thermal Proxy  -->
    <visual name="thermal_proxy">
      <geometry>
        <mesh>
          <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing%20person/tip/files/meshes/standing.dae</uri>
          <scale>1.02 1.02 1.02</scale>
        </mesh>
      </geometry>
      <transparency>1.0</transparency>
      <cast_shadows>false</cast_shadows>
      <plugin filename="ignition-gazebo-thermal-system" name="ignition::gazebo::systems::Thermal">
        <temperature>305.15</temperature>
      </plugin>
    </visual>
  </link>
</model>

